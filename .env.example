# BAMSO Environment Configuration
# Copy this file to .env and fill in the values.

# Required — SQLite database connection with busy_timeout and connection_limit
# socket_timeout: SQLite busy_timeout in seconds (waits up to 5s on lock)
# connection_limit: serializes all writes at Prisma pool level (single-instance safe)
DATABASE_URL="file:./dev.db?socket_timeout=5&connection_limit=1"

# Required — JWT signing secret (minimum 32 characters)
# Generate with: openssl rand -base64 48
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS"

# Optional — Redis (fail-open if missing, used for rate-limit + SSE pub/sub)
# REDIS_HOST="localhost"
# REDIS_PORT="6379"
# REDIS_PASSWORD=""

# Optional — Feature flags
# DEMO_MODE_ENABLED="false"
# RATE_LIMIT_DISABLED="false"
