# BAMSO Environment Configuration
# Copy this file to .env and fill in production values.
# NEVER commit .env to version control.

# Database
DATABASE_URL="file:./dev.db?socket_timeout=5&connection_limit=1"

# JWT Secret — REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Minimum 32 characters in production.
JWT_SECRET=""

# Edge TTS token (optional, for Edge TTS provider)
EDGE_TTS_TOKEN=""

# Rate limiting — set to "false" or remove in production to ENABLE rate limiting
RATE_LIMIT_DISABLED="true"

# Demo mode — set to "false" in production
DEMO_MODE_ENABLED="true"

# HTTPS — required for production LAN deployment
# HTTPS_PFX_PASSWORD="your-secure-password-here"
# HTTPS_PFX_PATH="./certs/bamso.pfx"
