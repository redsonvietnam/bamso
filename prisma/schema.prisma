// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  username      String         @unique
  passwordHash  String
  name          String
  role          String         @default("STAFF")
  mfaEnabled    Boolean        @default(false)
  mfaSecret     String?        // encrypted TOTP secret (iv:ciphertext:tag)
  mfaKeyVersion String?        // version identifier for MFA_ENCRYPTION_KEY
  mfaEnabledAt  DateTime?
  enrollmentJti String?        // current enrollment generation JTI (single-enrollment invariant)
  recoveryCodes RecoveryCode[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

model Service {
  id           String    @id @default(uuid())
  code         String    @unique
  name         String
  description  String?
  color        String
  prefix       String
  order        Int       @default(0)
  isActive     Boolean   @default(true)
  allowedModes String    @default("[\"quick\",\"manual\",\"qr\"]")
  tickets      Ticket[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Ticket {
  id           String       @id @default(uuid())
  ticketNumber String
  dayKey       String       @default("") // "YYYY-MM-DD" for daily uniqueness
  serviceId    String
  service      Service      @relation(fields: [serviceId], references: [id])
  customerName String?
  phone        String?
  status       String       @default("PENDING")
  position     Int
  missCount    Int          @default(0)
  pos          String?
  createdAt    DateTime     @default(now())
  calledAt     DateTime?
  completedAt  DateTime?

  @@unique([serviceId, dayKey, ticketNumber])
  @@unique([serviceId, dayKey, position])
  @@index([serviceId, dayKey, status])
}

model Settings {
  key   String @id @unique
  value String
}

model CallNextIdempotency {
  key          String   @id // client-supplied Idempotency-Key: one logical CALL-NEXT operation
  fingerprint  String   // JSON of serviceId + pos + actor; key reuse with a different fingerprint is rejected
  ticketId     String?  // claimed ticket once the operation commits; row is created atomically with the mutation
  ticketNumber String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CreateTicketIdempotency {
  key         String   @id // client-supplied Idempotency-Key: one logical CREATE-TICKET operation
  fingerprint String   // JSON of serviceId + customerName + phone; key reuse with a different fingerprint is rejected
  ticketJson  String   // canonical JSON of the original ticket creation result for replay
  createdAt   DateTime @default(now())
}

model DisplayCallEvent {
  id               String   @id @default(uuid())
  eventId          String   @unique // stable identity — survives retries, reconnects, restarts
  callNextKey      String?  // links to CallNextIdempotency.key for idempotent operations; null for legacy
  ticketId         String   // claimed ticket ID
  ticketNumber     String   // ticket number displayed to customer
  serviceId        String
  pos              String   // counter position
  customerName     String?
  nextTicketNumber String?  // next-in-queue hint for display
  sequence         Int      @default(0) // monotonic ordering within business day
  status           String   @default("PENDING") // PENDING | DELIVERED
  createdAt        DateTime @default(now())

  @@index([status, createdAt])
  @@index([callNextKey])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorType  String   // USER | ANONYMOUS | SYSTEM
  actorId    String?
  actorRole  String?  // STAFF | ADMIN | null
  action     String   // LOGIN | TICKET_CREATED | CALL_NEXT | SKIP | COMPLETE | RESTORE
  entityType String   // AUTH | TICKET
  entityId   String?
  success    Boolean
  reasonCode String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityId, createdAt])
}

