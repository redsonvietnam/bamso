# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local postgres database
/pgdata

# local sqlite database
*.db
*.db-journal

# scratch / test files
/scratch/

# local tooling artifacts
/.codegraph/
/.cursor/
/.agents/
/.specify/

# temp files
/.temp/

# local logs
*.log

# local archives
*.zip

